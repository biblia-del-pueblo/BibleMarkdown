<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackAsTool Condition="$(PackAsTool) == ''">false</PackAsTool>

        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVerison>14</LangVerison>
        <!--<GenerateAssemblyInfo>false</GenerateAssemblyInfo>-->
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        <AssemblyName>bibmark</AssemblyName>

        <Title>BibleMarkdown</Title>
        <Authors>simonegli8</Authors>
        <Company>Biblia del Pueblo</Company>
        <Product>BibleMarkdown</Product>
        <Description>A Markdown converter tailored for creation of Bibles</Description>
        <Copyright>Estrellas de Esperanza © 2026</Copyright>
        <PackageProjectUrl>https://github.com/biblia-del-pueblo/BibleMarkdown</PackageProjectUrl>
        <PackageReadmeFile Condition="$(PackAsTool) != 'true'">README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/biblia-del-pueblo/BibleMarkdown</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>OpenSource, Bible, Bibles, Public Domain, Biblia, Markdown, Bible Markdown, Bible Converter</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <IncludeSymbols>true</IncludeSymbols>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
        <ToolCommandName>bibmark</ToolCommandName>
        <PackageOutputPath>../nupkg</PackageOutputPath>
        <!-- Do not set IncludeContentInPack to false: NuGet then skips collecting every item marked Pack="true",
             including the README.md below, and pack fails with NU5039 "The readme file does not exist in the package". -->
        <IncludeBuildOutput>true</IncludeBuildOutput>
    </PropertyGroup>

    <PropertyGroup Condition="$(PackAsTool) == 'true'">
        <PackageReadmeFile>tools/net10.0/any/README.md</PackageReadmeFile>
        <PackageId>BibleMarkdown</PackageId>
        <StartupObject Condition="$(PackAsTool) == 'true'">BibleMarkdown.Program</StartupObject>
        <OutputType>Exe</OutputType>
        <DefineConstants>$(DefineConstants);Tool</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="$(PackAsTool) != 'true'">
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageId>BibleMarkdown.Library</PackageId>
        <OutputType>Library</OutputType>
    </PropertyGroup>


    <ItemGroup>
        <PackageReference Include="CliWrap" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" />
        <PackageReference Include="Newtonsoft.Json" />
        <PackageReference Include="LiteDB" />
    </ItemGroup>

    <ItemGroup>
        <None Condition="$(PackAsTool) != 'true'" Include="..\README.md">
            <Pack>True</Pack>
            <PackagePath>/</PackagePath>
        </None>
        <None Condition="$(PackAsTool) == 'true'" Include="..\README.md">
            <Pack>True</Pack>
            <PackagePath>/tools/net10.0/any/</PackagePath>
        </None>
    </ItemGroup>


    <ItemGroup Condition="$(PackAsTool) == 'true'">
        <None Update="runtimes\**\*.*"
            Pack="True" PackagePath="/tools/net10.0/any">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    
    <ItemGroup Condition="$(PackAsTool) != 'true'">
        <None Update="runtimes\**\*.*"
            Pack="True" PackagePath="/lib/net10.0">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!--<Target Name="IncludeReadmeInPackage" AfterTargets="Build">
        <Copy
          SourceFiles="..\README.md"
          DestinationFiles="README.md" />
    </Target>-->
</Project>
